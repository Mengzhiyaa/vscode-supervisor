{
    "name": "vscode-supervisor-webview",
    "private": true,
    "version": "0.0.2",
    "type": "module",
    "scripts": {
        "dev": "vite build --watch",
        "build": "vite build",
        "dev:serve": "vite",
        "dev:console": "vite --config vite.config.ts --open /dev/console-hmr.html",
        "check": "svelte-check --tsconfig ./tsconfig.json",
        "test:integration": "npm run build && playwright test -c test/playwright.config.ts"
    },
    "dependencies": {
        "@vscode/codicons": "^0.0.46-24",
        "monaco-editor": "^0.56.0",
        "vscode-jsonrpc": "^9.0.1",
        "vscode-oniguruma": "^2.0.1",
        "vscode-textmate": "^9.3.2"
    },
    "devDependencies": {
        "@playwright/test": "^1.54.2",
        "@sveltejs/vite-plugin-svelte": "^7.3.0",
        "@tsconfig/svelte": "^5.0.8",
        "svelte": "^5.56.9",
        "svelte-check": "^4.7.6",
        "typescript": "^5.9.3",
        "vite": "^8.2.1"
    }
}
